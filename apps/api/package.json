{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "start": "node build/index.js",
    "local": "NODE_ENV=local nodemon",
    "dev": "NODE_ENV=dev nodemon",
    "tsc": "rimraf build && tsc -p tsconfig.src.json && tsc-alias -p tsconfig.src.json && rimraf *.tsbuildinfo",
    "build": "npm run tsc",
    "populate": "tsx src/populate.ts",
    "test": "RUNTIME=ts NODE_ENV=test jest"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "ts,json",
    "exec": "tsx src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@keycloak/keycloak-admin-client": "^26.5.2",
    "@repo/shared-types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "pino": "^9.4.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.9",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
