RUNTIME=ts

NODE_ENV=dev
PORT=4000

REDIS_URL=redis://redis:6379

WEB_ORIGIN=https://fale-com-a-missao.com.br,http://fale-com-a-missao.com.br

KEYCLOAK_BASE_URL=http://keycloak:8080/auth
