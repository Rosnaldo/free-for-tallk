{
    "compilerOptions": {
        "outDir": "./build",
        "rootDir": "./src",
        "module": "commonjs",
        "ignoreDeprecations": "5.0",
        "target": "ES2020",
        "esModuleInterop": true,
        "strict": true,
        "typeRoots": [
            "./src/@types",
            "./@types",
            "./node_modules/@types",
            "../../node_modules/@types"
        ],
        "composite": true
    },
    "extends": "./tsconfig.base.json",
    "files": ["./src/@types/express/index.d.ts"],
    "include": ["./src"]
}
