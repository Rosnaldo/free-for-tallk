{
  "name": "realtime",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "imports": {
    "#apis/*": "./src/apis/*.ts",
    "#types/*": "./src/types/*.ts",
    "#websocket/*": "./src/websocket/*.ts",
    "#properties": "./src/properties.ts",
    "#logger": "./src/logger.ts"
  },
  "scripts": {
    "start": "node build/index.js",
    "local": "NODE_ENV=local nodemon",
    "dev": "NODE_ENV=dev nodemon",
    "tsc": "rimraf build && tsc -p tsconfig.src.json && tsc-alias -p tsconfig.src.json && rimraf *.tsbuildinfo",
    "build": "npm run tsc"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "exec": "tsx src/index.ts"
  },
  "dependencies": {
    "@repo/shared-types": "*",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "lodash": "^4.18.1",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.14.9",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
